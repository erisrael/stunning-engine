{
  "name": "myseed-content-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "templates": "tsx scripts/generate-templates.ts",
    "checks": "tsx scripts/run-checks.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "test:e2e": "tsx tests/run.ts --e2e",
    "test:all": "tsx tests/run.ts --all",
    "backup": "tsx scripts/backup.ts",
    "setup": "npm run db:reset && npm run templates",
    "verify": "tsx scripts/verify.ts",
    "db:reset": "tsx scripts/seed.ts reset",
    "db:empty": "tsx scripts/seed.ts empty",
    "db:import": "tsx scripts/seed.ts import",
    "db:status": "tsx scripts/seed.ts status",
    "db:counts": "tsx scripts/db-counts.ts",
    "db:set-password": "tsx scripts/set-password.ts",
    "panel": "python control-panel/control_panel.py",
    "db:restore": "tsx scripts/backup.ts --restore",
    "db:bulk-restore": "tsx scripts/bulk-restore.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@vladmandic/face-api": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "exceljs": "^3.4.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "modern-screenshot": "^4.6.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
