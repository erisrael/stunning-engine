# Copy to .env.local and adjust. All values are optional for local development.

# PostgreSQL connection string. Leave empty locally to use the embedded database in data/pg.
# On Netlify use the Supabase transaction pooler (port 6543), for example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Connections per server instance (keep small on serverless hosts).
DATABASE_POOL_SIZE=5

# Folder for the embedded database when DATABASE_URL is empty.
# PGLITE_DIR=./data/pg

# Set to 0 in production to hide the starting account list on the login page.
MYSEED_SHOW_DEMO_ACCOUNTS=1

# Set to 1 only when testing a production build over plain HTTP.
MYSEED_INSECURE_COOKIES=0

# Secret that protects /api/cron/checks (the scheduled alerts endpoint).
CRON_SECRET=
